{
  "name": "CRM-contact bij Nieuw \u2192 Contacten",
  "description": "Zodra een lead van Nieuw naar Contacten gaat, wordt automatisch een contactpersoon aangemaakt in Zoho CRM met alle leadgegevens en de koppeling terug naar de lead.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.old_data.status == \"Nieuw\") and (.trigger.data.status == \"Contacten\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "crm_contact_bij_nieuw_contacten",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createCrmContact",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "createCrmContact"
  }
}