{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique settings key, e.g. 'main'"
    },
    "smartsuite_api_token": {
      "type": "string"
    },
    "smartsuite_account_id": {
      "type": "string"
    },
    "smartsuite_solution_id": {
      "type": "string"
    },
    "smartsuite_table_id": {
      "type": "string"
    },
    "hub_shared_key": {
      "type": "string",
      "description": "Shared API key that other Base44 apps use to authenticate against the hubGetLeads endpoint (header x-hub-api-key)"
    }
  },
  "required": [
    "key"
  ]
}