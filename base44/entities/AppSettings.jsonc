{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique settings key, e.g. 'main'"
    },
    "smartsuite_api_token": {
      "type": "string"
    },
    "smartsuite_account_id": {
      "type": "string"
    },
    "smartsuite_solution_id": {
      "type": "string"
    },
    "smartsuite_table_id": {
      "type": "string"
    },
    "hub_shared_key": {
      "type": "string",
      "description": "Shared API key that other Base44 apps use to authenticate against the hubGetLeads endpoint (header x-hub-api-key)"
    },
    "lead_webhook_key": {
      "type": "string",
      "description": "Geheime sleutel waarmee SmartSuite leads naar de lead-webhook pusht (?secret= of body.secret). Is het veld leeg, dan weigert de webhook alles (401)."
    },
    "crm_webhook_url": {
      "type": "string",
      "description": "URL van de webhook-ontvanger in de CRM-app (Base44 hub-app 697b419b2ddb6f5c960bbf07) waar contactpersonen naartoe gepusht worden bij de overgang van Nieuw naar Contacten."
    },
    "crm_api_key": {
      "type": "string",
      "description": "Gedeelde API-sleutel die bij de CRM-webhook meegestuurd wordt (header x-crm-api-key)."
    }
  },
  "required": [
    "key"
  ]
}