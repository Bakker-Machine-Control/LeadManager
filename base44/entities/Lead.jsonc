{
  "name": "Lead",
  "type": "object",
  "properties": {
    "smartsuite_id": {
      "type": "string",
      "description": "The record ID from SmartSuite (source of the inbound lead)"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone_country": {
      "type": "string",
      "description": "Country code from SmartSuite phone field, e.g. NL, IE, AU"
    },
    "phone_e164": {
      "type": "string",
      "description": "Full international phone number in E.164 format, e.g. +31612345678"
    },
    "company": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "description": "City / place name"
    },
    "status": {
      "type": "string",
      "enum": [
        "nieuw",
        "te benaderen",
        "benaderd",
        "gekwalificeerd",
        "offerte",
        "gewonnen",
        "verloren",
        "niet gekwalificeerd",
        "duplicaat",
        "junk"
      ],
      "default": "nieuw",
      "description": "Werkstatus van de lead in het opvolgproces"
    },
    "smartsuite_status": {
      "type": "string",
      "description": "Informatieve status uit de SmartSuite-instroom (niet de werkstatus)"
    },
    "lead_date": {
      "type": "string"
    },
    "eigenaar": {
      "type": "string",
      "description": "Wie de lead oppakt"
    },
    "opvolgdatum": {
      "type": "string",
      "format": "date",
      "description": "Wanneer de volgende actie moet"
    },
    "reden_verloren": {
      "type": "string"
    },
    "bron": {
      "type": "string",
      "enum": [
        "smartsuite",
        "telefoon",
        "website",
        "aanbeveling",
        "overig"
      ],
      "default": "smartsuite",
      "description": "Herkomst van de lead"
    },
    "quote_id": {
      "type": "string",
      "description": "Verwijzing naar de offerte in de app 'Offerte hulp'"
    },
    "company_fsm_id": {
      "type": "string",
      "description": "Verwijzing naar Company in hub-app 697b419b2ddb6f5c960bbf07, zodra een lead klant wordt"
    },
    "contact_fsm_id": {
      "type": "string",
      "description": "Verwijzing naar Contact in hub-app 697b419b2ddb6f5c960bbf07, zodra een lead klant wordt"
    },
    "raw_data": {
      "type": "object",
      "description": "Raw record data from SmartSuite"
    }
  },
  "required": [
    "smartsuite_id"
  ]
}