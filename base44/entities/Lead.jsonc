{
  "name": "Lead",
  "type": "object",
  "properties": {
    "smartsuite_id": {
      "type": "string",
      "description": "The record ID from SmartSuite (source of the inbound lead)"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone_country": {
      "type": "string",
      "description": "Landcode uit het SmartSuite-telefoonveld. LET OP: 96,7% van de instroom is niet-Nederlands. Dit is Unicontrols wereldwijde Meta-trechter (AU 3.507, US 2.255, PL 1.861, GB 1.290, CA 1.164, NZ 1.105); slechts 474 leads zijn NL."
    },
    "phone_e164": {
      "type": "string",
      "description": "Volledig internationaal nummer, bijv. +31612345678. Dit is het gevulde veld; zoeken op 'phone' levert niets op."
    },
    "company": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "description": "City / place name"
    },
    "status": {
      "type": "string",
      "enum": [
        "Nieuw",
        "Contacten",
        "Afspraak",
        "Afgerond",
        "Afgewezen"
      ],
      "default": "Nieuw",
      "description": "Werkstatus in het opvolgproces van BMC \u2014 de vijf kolommen van het Kanban-bord. Los van smartsuite_status, die over de instroom gaat."
    },
    "smartsuite_status": {
      "type": "string",
      "description": "Informatieve status uit de SmartSuite-instroom (backlog / in_progress / complete). Gaat over Unicontrols verwerking, niet over of BMC gebeld heeft."
    },
    "lead_date": {
      "type": "string"
    },
    "eigenaar": {
      "type": "string",
      "description": "Wie de lead oppakt"
    },
    "opvolgdatum": {
      "type": "string",
      "format": "date",
      "description": "Wanneer de volgende actie moet"
    },
    "reden_verloren": {
      "type": "string"
    },
    "bron": {
      "type": "string",
      "enum": [
        "smartsuite",
        "telefoon",
        "website",
        "aanbeveling",
        "overig"
      ],
      "default": "smartsuite",
      "description": "Herkomst van de lead"
    },
    "quote_id": {
      "type": "string",
      "description": "Verwijzing naar de offerte in de app 'Offerte hulp'"
    },
    "company_fsm_id": {
      "type": "string",
      "description": "Verwijzing naar Company in hub-app 697b419b2ddb6f5c960bbf07, zodra een lead klant wordt"
    },
    "contact_fsm_id": {
      "type": "string",
      "description": "Verwijzing naar Contact in hub-app 697b419b2ddb6f5c960bbf07, zodra een lead klant wordt"
    },
    "zoho_contact_id": {
      "type": "string",
      "description": "ID van de contactpersoon in Zoho CRM. Wordt automatisch aangemaakt bij de overgang van Nieuw naar Contacten."
    },
    "zoho_contact_url": {
      "type": "string",
      "description": "Directe link naar de contactpersoon in Zoho CRM"
    },
    "meta_lead_id": {
      "type": "string",
      "description": "Meta-lead-id uit het SmartSuite-veld s9feaf3fda"
    },
    "ad_id": {
      "type": "string",
      "description": "Meta-advertentie-id uit het SmartSuite-veld sa4e1203ff"
    },
    "ad_naam": {
      "type": "string",
      "description": "Naam van de Meta-advertentie uit het SmartSuite-veld sa4820cf90"
    },
    "campagne": {
      "type": "string",
      "description": "Meta-campagnenaam uit het SmartSuite-veld s924edf549"
    },
    "formulier": {
      "type": "string",
      "description": "Meta-formuliernaam uit het SmartSuite-veld s351517cff"
    },
    "platform": {
      "type": "string",
      "description": "Platform van de Meta-instroom (bijv. fb / ig) uit het SmartSuite-veld s335a1f6d0"
    },
    "aangeleverde_tekst": {
      "type": "string",
      "description": "Aangeleverde tekst uit het Meta-formulier, uit het SmartSuite-veld sfa31637c2"
    },
    "score": {
      "type": "number",
      "description": "Verrijkingsscore. Hoger = beter passend bij de doelgroep van BMC. Leeg = nog niet verrijkt of onvoldoende gegevens."
    },
    "score_label": {
      "type": "string",
      "enum": [
        "Heet",
        "Warm",
        "Lauw",
        "Koud",
        "Onbekend"
      ],
      "description": "Categorie bij de score"
    },
    "score_reden": {
      "type": "string",
      "description": "Korte uitleg in het Nederlands waarom deze score is toegekend"
    },
    "verrijkt_op": {
      "type": "string",
      "format": "date-time",
      "description": "Wanneer de lead voor het laatst verrijkt is"
    },
    "verrijking_status": {
      "type": "string",
      "enum": [
        "niet_verrijkt",
        "gelukt",
        "onvoldoende_gegevens",
        "mislukt"
      ],
      "default": "niet_verrijkt",
      "description": "Stand van de online verrijking van deze lead"
    },
    "bedrijf_website": {
      "type": "string",
      "description": "Website van het bedrijf, online gevonden bij de verrijking"
    },
    "bedrijf_kvk": {
      "type": "string",
      "description": "KvK-nummer van het bedrijf, online gevonden bij de verrijking"
    },
    "bedrijf_sector": {
      "type": "string",
      "description": "Sector waarin het bedrijf actief is"
    },
    "bedrijf_omvang": {
      "type": "string",
      "description": "Indicatie aantal medewerkers"
    },
    "bedrijf_plaats": {
      "type": "string",
      "description": "Plaats waar het bedrijf gevestigd is"
    },
    "bedrijf_activiteit": {
      "type": "string",
      "description": "Wat het bedrijf doet, in \u00e9\u00e9n of twee zinnen"
    },
    "machinepark": {
      "type": "string",
      "description": "Wat er online te vinden is over graafmachines / eigen materieel"
    },
    "verrijking": {
      "type": "object",
      "description": "Volledige ruwe uitkomst van de online zoekopdracht, inclusief bronnen"
    },
    "raw_data": {
      "type": "object",
      "description": "Raw record data from SmartSuite. Bevat onder meer de campagne, het formuliertype (getaquote, bookademo) en een checklist met belpogingen van het internationale team."
    }
  },
  "required": [
    "smartsuite_id"
  ]
}