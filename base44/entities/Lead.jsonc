{
  "name": "Lead",
  "type": "object",
  "properties": {
    "smartsuite_id": {
      "type": "string",
      "description": "The record ID from SmartSuite (source of the inbound lead)"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone_country": {
      "type": "string",
      "description": "Landcode uit het SmartSuite-telefoonveld. LET OP: 96,7% van de instroom is niet-Nederlands. Dit is Unicontrols wereldwijde Meta-trechter (AU 3.507, US 2.255, PL 1.861, GB 1.290, CA 1.164, NZ 1.105); slechts 474 leads zijn NL."
    },
    "phone_e164": {
      "type": "string",
      "description": "Volledig internationaal nummer, bijv. +31612345678. Dit is het gevulde veld; zoeken op 'phone' levert niets op."
    },
    "company": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "description": "City / place name"
    },
    "status": {
      "type": "string",
      "enum": [
        "nieuw",
        "te benaderen",
        "benaderd",
        "gekwalificeerd",
        "offerte",
        "gewonnen",
        "verloren",
        "niet gekwalificeerd",
        "duplicaat",
        "junk",
        "afgehandeld"
      ],
      "default": "nieuw",
      "description": "Werkstatus in het opvolgproces van BMC. Los van smartsuite_status, die over de instroom gaat."
    },
    "smartsuite_status": {
      "type": "string",
      "description": "Informatieve status uit de SmartSuite-instroom (backlog / in_progress / complete). Gaat over Unicontrols verwerking, niet over of BMC gebeld heeft."
    },
    "lead_date": {
      "type": "string"
    },
    "eigenaar": {
      "type": "string",
      "description": "Wie de lead oppakt"
    },
    "opvolgdatum": {
      "type": "string",
      "format": "date",
      "description": "Wanneer de volgende actie moet"
    },
    "reden_verloren": {
      "type": "string"
    },
    "bron": {
      "type": "string",
      "enum": [
        "smartsuite",
        "telefoon",
        "website",
        "aanbeveling",
        "overig"
      ],
      "default": "smartsuite",
      "description": "Herkomst van de lead"
    },
    "quote_id": {
      "type": "string",
      "description": "Verwijzing naar de offerte in de app 'Offerte hulp'"
    },
    "company_fsm_id": {
      "type": "string",
      "description": "Verwijzing naar Company in hub-app 697b419b2ddb6f5c960bbf07, zodra een lead klant wordt"
    },
    "contact_fsm_id": {
      "type": "string",
      "description": "Verwijzing naar Contact in hub-app 697b419b2ddb6f5c960bbf07, zodra een lead klant wordt"
    },
    "raw_data": {
      "type": "object",
      "description": "Raw record data from SmartSuite. Bevat onder meer de campagne, het formuliertype (getaquote, bookademo) en een checklist met belpogingen van het internationale team."
    }
  },
  "required": [
    "smartsuite_id"
  ]
}