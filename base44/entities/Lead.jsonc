{
  "name": "Lead",
  "type": "object",
  "properties": {
    "smartsuite_id": {
      "type": "string",
      "description": "The record ID from SmartSuite (source of the inbound lead)"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone_country": {
      "type": "string",
      "description": "Landcode uit het SmartSuite-telefoonveld. LET OP: 96,7% van de instroom is niet-Nederlands. Dit is Unicontrols wereldwijde Meta-trechter (AU 3.507, US 2.255, PL 1.861, GB 1.290, CA 1.164, NZ 1.105); slechts 474 leads zijn NL."
    },
    "phone_e164": {
      "type": "string",
      "description": "Volledig internationaal nummer, bijv. +31612345678. Dit is het gevulde veld; zoeken op 'phone' levert niets op."
    },
    "company": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "description": "City / place name"
    },
    "status": {
      "type": "string",
      "enum": [
        "Nieuw",
        "Contacten",
        "Afspraak",
        "Afgerond",
        "Afgewezen"
      ],
      "default": "Nieuw",
      "description": "Werkstatus in het opvolgproces van BMC \u2014 de vijf kolommen van het Kanban-bord. Los van smartsuite_status, die over de instroom gaat."
    },
    "smartsuite_status": {
      "type": "string",
      "description": "Informatieve status uit de SmartSuite-instroom (backlog / in_progress / complete). Gaat over Unicontrols verwerking, niet over of BMC gebeld heeft."
    },
    "lead_date": {
      "type": "string"
    },
    "eigenaar": {
      "type": "string",
      "description": "Wie de lead oppakt"
    },
    "opvolgdatum": {
      "type": "string",
      "format": "date",
      "description": "Wanneer de volgende actie moet"
    },
    "reden_verloren": {
      "type": "string"
    },
    "bron": {
      "type": "string",
      "enum": [
        "smartsuite",
        "telefoon",
        "website",
        "aanbeveling",
        "overig"
      ],
      "default": "smartsuite",
      "description": "Herkomst van de lead"
    },
    "quote_id": {
      "type": "string",
      "description": "Verwijzing naar de offerte in de app 'Offerte hulp'"
    },
    "company_fsm_id": {
      "type": "string",
      "description": "Verwijzing naar Company in hub-app 697b419b2ddb6f5c960bbf07, zodra een lead klant wordt"
    },
    "contact_fsm_id": {
      "type": "string",
      "description": "Verwijzing naar Contact in hub-app 697b419b2ddb6f5c960bbf07, zodra een lead klant wordt"
    },
    "meta_lead_id": {
      "type": "string",
      "description": "Meta-lead-id uit het SmartSuite-veld s9feaf3fda"
    },
    "ad_id": {
      "type": "string",
      "description": "Meta-advertentie-id uit het SmartSuite-veld sa4e1203ff"
    },
    "ad_naam": {
      "type": "string",
      "description": "Naam van de Meta-advertentie uit het SmartSuite-veld sa4820cf90"
    },
    "campagne": {
      "type": "string",
      "description": "Meta-campagnenaam uit het SmartSuite-veld s924edf549"
    },
    "formulier": {
      "type": "string",
      "description": "Meta-formuliernaam uit het SmartSuite-veld s351517cff"
    },
    "platform": {
      "type": "string",
      "description": "Platform van de Meta-instroom (bijv. fb / ig) uit het SmartSuite-veld s335a1f6d0"
    },
    "aangeleverde_tekst": {
      "type": "string",
      "description": "Aangeleverde tekst uit het Meta-formulier, uit het SmartSuite-veld sfa31637c2"
    },
    "raw_data": {
      "type": "object",
      "description": "Raw record data from SmartSuite. Bevat onder meer de campagne, het formuliertype (getaquote, bookademo) en een checklist met belpogingen van het internationale team."
    }
  },
  "required": [
    "smartsuite_id"
  ]
}