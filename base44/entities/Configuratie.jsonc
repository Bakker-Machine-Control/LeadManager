{
  "name": "Configuratie",
  "type": "object",
  "description": "Eén gestarte configuratie in de webshop (GPS-meetstok), ook als de bezoeker geen aanvraag doet. Aangeleverd door de tracking-service op de Mac Studio via websiteTrack (event-type 'configuratie'). Zonder cookietoestemming is bezoeker_id leeg: dan is de configuratie niet te koppelen aan eerdere bezoeken.",
  "properties": {
    "configuratie_id": { "type": "string", "description": "Uniek ID per configuratie, uit de webshop" },
    "omgeving": { "type": "string", "enum": ["staging", "productie"], "default": "productie" },
    "status": { "type": "string", "enum": ["bezig", "aangevraagd"], "default": "bezig", "description": "aangevraagd = de bezoeker heeft de order ingediend (order_ref gevuld)" },
    "gestart_op": { "type": "string", "format": "date-time" },
    "laatst_actief": { "type": "string", "format": "date-time" },
    "laatste_stap": { "type": "number", "description": "Hoogste stap die de bezoeker bereikte" },
    "laatste_stap_titel": { "type": "string" },
    "stappen_totaal": { "type": "number" },
    "keuzes": { "type": "array", "items": { "type": "object" }, "description": "Gekozen artikelen: [{ sku, naam }]" },
    "keuzes_tekst": { "type": "string", "description": "Leesbare samenvatting van de keuzes" },
    "totaal_excl_btw": { "type": "number" },
    "totaal_incl_btw": { "type": "number" },
    "order_ref": { "type": "string", "description": "Ordernummer in de webshop zodra de aanvraag is ingediend" },
    "toestemming": { "type": "boolean", "default": false, "description": "Heeft de bezoeker cookies/volgen toegestaan" },
    "bezoeker_id": { "type": "string", "description": "Alleen bij toestemming: koppeling met Bezoeker" },
    "bezoek_id": { "type": "string" },
    "plaats": { "type": "string" },
    "provincie": { "type": "string" },
    "land": { "type": "string" },
    "landcode": { "type": "string" },
    "lat": { "type": "number" },
    "lon": { "type": "number" },
    "ip_adres": { "type": "string", "description": "Ingekort IP-adres (laatste octet is 0)" },
    "browser": { "type": "string" },
    "besturingssysteem": { "type": "string" },
    "apparaat": { "type": "string", "enum": ["desktop", "mobiel", "tablet", "onbekend"], "default": "onbekend" },
    "referrer": { "type": "string" },
    "bron": { "type": "string" },
    "utm_source": { "type": "string" },
    "utm_medium": { "type": "string" },
    "utm_campaign": { "type": "string" }
  },
  "required": ["configuratie_id", "gestart_op"]
}
